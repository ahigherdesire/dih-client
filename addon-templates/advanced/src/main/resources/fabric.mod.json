{
  "schemaVersion": 1,
  "id": "dih-advanced-addon-template",
  "version": "${version}",
  "name": "DIH Advanced",
  "description": "Reference addon for DIH Client: a module, macro action, preset, condition, command, HUD element, and event hook.",
  "authors": [
    "You"
  ],
  "custom": {
    "dih:color": "255,80,80",
    "modmenu": {
      "parent": {
        "id": "dih"
      }
    }
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.addon.ExampleInit"
    ],
    "dih": [
      "com.example.addon.ExampleAddon"
    ]
  },
  "mixins": [
    "dih-advanced-addon-template.mixins.json"
  ],
  "depends": {
    "java": ">=25",
    "minecraft": "${mc_compat}",
    "fabricloader": ">=0.19.3",
    "fabric-api": ">=${fabric_api_version}",
    "dih": ">=${dih_api_version}"
  }
}
