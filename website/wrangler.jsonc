// The site is a Worker with static assets, deployed by Workers Builds on every push to main.
// Static files are served straight from the assets without running the Worker; the Worker only
// runs for /dl/* (count a download, then redirect to the jar on GitHub) and /api/* (the counts).
{
  "name": "dih-client-site",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-25",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/dl/*", "/api/*"]
  },
  // Schema changes: add a file to worker/migrations, then
  //   npx wrangler d1 migrations apply dih-downloads --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dih-downloads",
      "database_id": "5e623b92-cc6d-41e8-9669-948b5f1980d2",
      "migrations_dir": "worker/migrations"
    }
  ],
  "observability": { "enabled": true }
}
